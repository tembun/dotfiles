[core]
	editor = vim -c 'startinsert'
	autocrlf = false
	quotepath = false
	pager = less -X
	abbrev = 12
	packedGitLimit = 512m
	packedGitWindowSize = 512m
	compression = 0
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = Artem Bunichev
	email = temcbun@gmail.com
[alias]
	s = status --short
	ss = ! git s | grep '^[AMDR]'
	br = branch
	brc = branch --show-current
	co = checkout
	ll = log --oneline
	last = log --oneline -n 1 HEAD
	p = push origin HEAD
	f = pull origin HEAD
	alt = commit --amend --no-edit
	wip = ! git commit --no-verify -m \"WIP: $(git branch --show-current)\"
	pop = reset HEAD~1
	day = ll --since=midnight --author=temcbun --branches='*'
	fix = "!f() { t=/tmp/__gitfix; printf \"\n\nFixes:	${@}\" >${t}; git commit --template ${t}; rm -f ${t}; }; f"
	diffc = diff --cached
	difft = diff-tree --name-status -r
	counnt = rev-list --count
	find = log --grep
	cat = cat-file -p
	flict = diff --check
	no = branch --no-merged
	ignr = check-ignore
	info = log -n 1 --pretty='%h (\"%s\")'
[credential]
	helper = store
[push]
	default = nothing
[color]
	ui=true
[color "diff"]
	meta = normal dim
	frag = normal dim
	func = white
	context = white
	commit = yellow
	old = brightred dim
	new = brightgreen dim
[color "status"]
	added = brightgreen
	changed = brightyellow
	untracked = white
[color "branch"]
	current = brightyellow
	local = white
	remote = brightwhite
	upstream = brightwhite
[color "decorate"]
	HEAD = brightcyan dim
	branch = brightwhite dim
	remoteBranch = brightblue dim
	tag = yellow
	stash = red
[safe]
	directory = *
[init]
	defaultBranch = main
[http]
	postBuffer = 100000000
	lowSpeedLimit = 0
	lowSpeedTime = 999999
[pack]
	deltaCacheSize = 2047m
	packSizeLimit = 2047m
	windowMemory = 2047m
[credential "https://github.com"]
	helper =
	helper = !/usr/local/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/local/bin/gh auth git-credential
